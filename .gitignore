# Ignore dot directories and files (except .opencode/)
.*
!.opencode/
!.opencode/**

# Don't ignore .git directory and .gitignore
!.gitignore
!.gitattributes
!.gitkeep

# Python
__pycache__/
*.pyc
*.pyo

# Dependencies
node_modules/

# Logs
log/

# Runtime state
.pipeline_state.json

# Temporary analysis and evaluation directories
tech_analyze/
缺陷评估/

# Convenience startup script (local only)
start-opencode.bat

# Large binary files in raw crawled data (exclude PDF/RAR/ZIP to avoid repo bloat)
knowledge/raw/**/*.pdf
knowledge/raw/**/*.rar
knowledge/raw/**/*.zip