{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-v4-flash",
  "provider": {
    "ls_gateway": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "1.LS-Gatewany",
      "options": {
        "baseURL": "http://192.168.7.27:19997/api/v1",
        "apiKey": "{env:LS_GATEWAY_API_KEY}"
      },
      "models": {
        "qwen3.6-plus": {
          "name": "qwen3.6-plus"
        },
        "glm-4.7": {
          "name": "glm-4.7"
        },
        "kimi-k2.5": {
          "name": "kimi-k2.5"
        },
        "MiniMax-M2.5": {
          "name": "MiniMax-M2.5"
        },
        "deepseek-v4-flash": {
          "name": "deepseek-v4-flash"
        },
        "deepseek-v4-pro": {
          "name": "deepseek-v4-pro"
        }
      }
    },
    "deepseek": {
      "options": {
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "deepseek-v4-flash"
        },
        "deepseek-v4-pro": {
          "name": "deepseek-v4-pro"
        }
      }
    }
  }
}
